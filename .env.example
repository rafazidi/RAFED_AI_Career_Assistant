# Backend
APP_NAME=Rafed AI
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# RAG
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_DIR=./backend/data/chroma
KNOWLEDGE_BASE_DIR=./knowledge_base
TOP_K=5

# GitHub projects
GITHUB_OWNER=rafazidi
GITHUB_TOPIC=portfolio
GITHUB_CACHE_TTL_SECONDS=300

# LLM provider compatible with the OpenAI Chat Completions API
# Keep this key only in this local .env file. Never put it in frontend code.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TEMPERATURE=0.2
